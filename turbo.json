{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".svelte-kit/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": [
        "DB_PATH",
        "JWT_SECRET",
        "ENCRYPTION_KEY",
        "PLATFORM_DOMAIN",
        "ACME_EMAIL",
        "PORT",
        "NODE_ENV",
        "LOG_LEVEL",
        "QUEUE_POLL_MS",
        "API_URL",
        "DEPLOYX_VERSION"
      ]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
